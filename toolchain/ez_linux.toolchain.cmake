set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

# EZ826/JC371 uses 32-bit ARM hard-float (build.sh linux arm ez).
# Configure the compiler installation here before running the build scripts.
set(EZ_TOOLCHAIN_DIR "/home/yuwei/opt/gcc-linaro-7.5.0-2019.12-x86_64_arm-linux-gnueabihf")
set(EZ_TOOLCHAIN_PREFIX "arm-linux-gnueabihf")
set(EZ_SYSROOT "${EZ_TOOLCHAIN_DIR}/${EZ_TOOLCHAIN_PREFIX}/libc")

set(CMAKE_C_COMPILER   "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-g++")
set(CMAKE_SYSROOT "${EZ_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_AR      "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-ar")
set(CMAKE_RANLIB  "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-ranlib")
set(CMAKE_STRIP   "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-strip")
set(CMAKE_OBJCOPY "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-objcopy")
set(CMAKE_OBJDUMP "${EZ_TOOLCHAIN_DIR}/bin/${EZ_TOOLCHAIN_PREFIX}-objdump")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
