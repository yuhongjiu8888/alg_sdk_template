{
  "solution": {
    "type": "chain",
    "stages": [
      {
        "name": "ssn_det",
        "model": "ssn_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "ssn_cls",
        "model": "cls_cfg",
        "input": "objects_from:ssn_det",
        "crop": {
          "expand_ratio": 1.5,
          "square": true,
          "pad_value": 114
        },
        "score_threshold": 0.6,
        "passthrough": [
          { "label": 1, "category": "pare", "sign_value": 2, "min_score": 0.0 }
        ],
        "min_box_short": { "no_parking": 40 },
        "produces": "classify_into:ssn_det"
      },
      {
        "name": "license_det",
        "model": "license_det_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "license_rec",
        "model": "license_rec_cfg",
        "input": "objects_from:license_det",
        "crop": {
          "expand_ratio": 1.0,
          "square": false
        },
        "produces": "classify_into:license_det"
      }
    ]
  },
  "models": {
    "ssn_cfg": {
      "model_path": "../resources/model/svp_acl/speedsignnet_aipp.om",
      "preprocess": {
        "input_size": [576, 320],
        "engine": "aipp",
        "input_format": "auto",
        "max_input_size": [1920, 1080],
        "aipp_output_size": [568, 320],
        "aipp_graph_padding": [4, 0, 4, 0],
        "color": "RGB",
        "resize": "letterbox_center",
        "layout": "NCHW",
        "pad_value": 114
      },
      "postprocess": {
        "type": "yolov5_anchor_det",
        "num_classes": 2,
        "bbox_channels": 4,
        "obj_channels": 1,
        "stride": 8,
        "anchor": [36, 36],
        "conf_threshold": 0.25,
        "nms_threshold": 0.45,
        "max_det": 5,
        "obj_prefilter": 0.05
      }
    },
    "cls_cfg": {
      "model_path": "../resources/model/svp_acl/classifier.om",
      "preprocess": {
        "input_size": [96, 96],
        "engine": "auto",
        "color": "RGB",
        "resize": "stretch",
        "layout": "NCHW",
        "pad_value": 114
      },
      "postprocess": {
        "type": "ocr_classifier",
        "category": "speed_limit",
        "num_positions": 3,
        "num_chars": 11,
        "blank_index": 10,
        "conf_threshold": 0.7,
        "gate_channels": 3,
        "gate_speed_index": 1,
        "gate_nopark_index": 2,
        "gate_threshold": 0.5,
        "nopark_category": "no_parking",
        "nopark_sign_value": 1,
        "class_names": [
          "10", "20", "30", "40", "50", "60", "70",
          "80", "100", "90", "110", "120"
        ]
      }
    },
    "license_det_cfg": {
      "model_path": "../resources/model/svp_acl/license_detection_aipp.om",
      "preprocess": {
        "input_size": [640, 448],
        "engine": "aipp",
        "input_format": "auto",
        "max_input_size": [1920, 1080],
        "aipp_output_size": [640, 360],
        "aipp_graph_padding": [0, 0, 0, 88],
        "color": "RGB",
        "resize": "letterbox_tl_fit",
        "layout": "NCHW",
        "pad_value": 114
      },
      "postprocess": {
        "type": "rtmdet_det",
        "num_classes": 1,
        "bbox_channels": 4,
        "strides": [8, 16, 32],
        "input_size": [640, 448],
        "conf_threshold": 0.25,
        "nms_threshold": 0.45,
        "min_bbox_size": 4.0,
        "max_det": 2
      }
    },
    "license_rec_cfg": {
      "model_path": "../resources/model/svp_acl/license_recognizer.om",
      "preprocess": {
        "input_size": [256, 64],
        "engine": "auto",
        "color": "RGB",
        "resize": "letterbox_center",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "lprnet_rec",
        "category": "license_plate",
        "characters": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "blank_index": 36,
        "timesteps": 32,
        "channels": 37
      }
    }
  }
}
