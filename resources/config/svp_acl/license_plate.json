{
  "solution": {
    "type": "chain",
    "stages": [
      {
        "name": "detector",
        "model": "det_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "recognizer",
        "model": "rec_cfg",
        "input": "objects_from:detector",
        "crop": {
          "expand_ratio": 1.0,
          "square": false
        },
        "produces": "classify_into:detector"
      }
    ]
  },
  "models": {
    "det_cfg": {
      "model_path": "../resources/model/svp_acl/license_detection_aipp.om",
      "preprocess": {
        "input_size": [640, 448],
        "engine": "aipp",
        "input_format": "auto",
        "max_input_size": [1920, 1080],
        "aipp_output_size": [640, 360],
        "aipp_graph_padding": [0, 0, 0, 88],
        "color": "RGB",
        "resize": "letterbox_tl_fit",
        "layout": "NCHW",
        "pad_value": 114
      },
      "postprocess": {
        "type": "rtmdet_det",
        "num_classes": 1,
        "bbox_channels": 4,
        "strides": [8, 16, 32],
        "input_size": [640, 448],
        "conf_threshold": 0.25,
        "nms_threshold": 0.45,
        "min_bbox_size": 4.0,
        "max_det": 2
      }
    },
    "rec_cfg": {
      "model_path": "../resources/model/svp_acl/license_recognizer.om",
      "preprocess": {
        "input_size": [256, 64],
        "engine": "auto",
        "color": "RGB",
        "resize": "letterbox_center",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "lprnet_rec",
        "category": "license_plate",
        "characters": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "blank_index": 36,
        "timesteps": 32,
        "channels": 37
      }
    }
  }
}
