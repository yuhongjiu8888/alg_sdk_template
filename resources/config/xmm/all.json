{
  "solution": {
    "type": "chain",
    "stages": [
      {
        "name": "tld",
        "model": "tld_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "ssn_det",
        "model": "ssn_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "ssn_cls",
        "model": "cls_cfg",
        "input": "objects_from:ssn_det",
        "crop": {
          "expand_ratio": 1.5,
          "square": true,
          "pad_value": 114
        },
        "score_threshold": 0.6,
        "passthrough": [
          { "label": 1, "category": "pare", "sign_value": 2, "min_score": 0.0 }
        ],
        "min_box_short": { "no_parking": 40 },
        "produces": "classify_into:ssn_det"
      }
    ]
  },
  "models": {
    "tld_cfg": {
      "model_path": "../resources/model/xmm/traffic_light.xmm",
      "preprocess": {
        "input_size": [
          416,
          416
        ],
        "color": "RGB",
        "resize": "letterbox_tl",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "yolox_det",
        "category": "traffic_light",
        "num_classes": 4,
        "bbox_channels": 4,
        "obj_channels": 1,
        "strides": [
          8,
          16,
          32
        ],
        "conf_threshold": 0.4,
        "nms_threshold": 0.5,
        "max_det": 100,
        "obj_prefilter": 0.05,
        "class_names": [
          "red_light",
          "yellow_light",
          "green_light",
          "off_light"
        ]
      }
    },
    "ssn_cfg": {
      "model_path": "../resources/model/xmm/speedsignnet.xmm",
      "preprocess": {
        "input_size": [
          576,
          320
        ],
        "color": "RGB",
        "resize": "letterbox_center",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "yolov5_anchor_det",
        "num_classes": 2,
        "bbox_channels": 4,
        "obj_channels": 1,
        "stride": 8,
        "anchor": [
          36,
          36
        ],
        "conf_threshold": 0.6,
        "nms_threshold": 0.45,
        "max_det": 5,
        "obj_prefilter": 0.05
      }
    },
    "cls_cfg": {
      "model_path": "../resources/model/xmm/classifier.xmm",
      "preprocess": {
        "input_size": [
          96,
          96
        ],
        "color": "RGB",
        "resize": "stretch",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "ocr_classifier",
        "category": "speed_limit",
        "num_positions": 3,
        "num_chars": 11,
        "blank_index": 10,
        "conf_threshold": 0.6,
        "gate_channels": 3,
        "gate_speed_index": 1,
        "gate_nopark_index": 2,
        "gate_threshold": 0.5,
        "nopark_category": "no_parking",
        "nopark_sign_value": 1,
        "class_names": [
          "10",
          "20",
          "30",
          "40",
          "50",
          "60",
          "70",
          "80",
          "100",
          "90",
          "110",
          "120"
        ]
      }
    }
  }
}
