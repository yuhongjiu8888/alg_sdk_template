{
  "solution": {
    "type": "chain",
    "stages": [
      {
        "name": "detector",
        "model": "ssn_cfg",
        "input": "image",
        "produces": "objects"
      },
      {
        "name": "classifier",
        "model": "cls_cfg",
        "input": "objects_from:detector",
        "crop": {
          "expand_ratio": 1.5,
          "square": true,
          "pad_value": 114
        },
        "score_threshold": 0.5,
        "produces": "classify_into:detector"
      }
    ]
  },
  "models": {
    "ssn_cfg": {
      "model_path": "../resources/model/xmm/speedsignnet.xmm",
      "preprocess": {
        "input_size": [
          576,
          320
        ],
        "color": "RGB",
        "resize": "letterbox_center",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "yolov5_anchor_det",
        "num_classes": 1,
        "bbox_channels": 4,
        "obj_channels": 1,
        "stride": 8,
        "anchor": [
          36,
          36
        ],
        "conf_threshold": 0.6,
        "nms_threshold": 0.45,
        "max_det": 64,
        "obj_prefilter": 0.05
      }
    },
    "cls_cfg": {
      "model_path": "../resources/model/xmm/classifier.xmm",
      "preprocess": {
        "input_size": [
          64,
          64
        ],
        "color": "RGB",
        "resize": "stretch",
        "layout": "NCHW",
        "pad_value": 0
      },
      "postprocess": {
        "type": "ocr_classifier",
        "category": "speed_limit",
        "num_positions": 3,
        "num_chars": 11,
        "blank_index": 10,
        "conf_threshold": 0.6,
        "class_names": [
          "10",
          "20",
          "30",
          "40",
          "50",
          "60",
          "70",
          "80",
          "100",
          "90",
          "110",
          "120"
        ]
      }
    }
  }
}