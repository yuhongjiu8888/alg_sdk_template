{
  "solution": {
    "type": "chain",
    "stages": [
      {
        "name": "tld",
        "model": "tld_cfg",
        "input": "image",
        "produces": "objects"
      }
    ]
  },
  "models": {
    "tld_cfg": {
      "model_path": "../resources/model/mnn/traffic_light.mnn",
      "preprocess": {
        "input_size": [
          416,
          416
        ],
        "color": "RGB",
        "resize": "letterbox_tl",
        "layout": "NCHW",
        "pad_value": 0,
        "mean": [
          0,
          0,
          0
        ],
        "std": [
          255,
          255,
          255
        ]
      },
      "postprocess": {
        "type": "yolox_det",
        "category": "traffic_light",
        "num_classes": 4,
        "bbox_channels": 4,
        "obj_channels": 1,
        "strides": [
          8,
          16,
          32
        ],
        "conf_threshold": 0.5,
        "nms_threshold": 0.5,
        "max_det": 100,
        "obj_prefilter": 0.05,
        "class_names": [
          "red_light",
          "yellow_light",
          "green_light",
          "off_light"
        ]
      }
    }
  }
}