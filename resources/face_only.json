{
  "solution": {
    "type": "chain",
    "stages": [
      { "name": "detector", "model": "detector_cfg", "input": "image", "produces": "objects" }
    ]
  },
  "models": {
    "detector_cfg": {
      "model_path": "/data/face_det.xmm",
      "preprocess": {
        "input_size": [320, 320],
        "color": "BGR",
        "resize": "letterbox_tl",
        "layout": "NCHW"
      },
      "postprocess": {
        "type": "fcos_face",
        "conf_threshold": 0.6,
        "nms_threshold": 0.4,
        "strides": [4, 8, 16, 32]
      }
    }
  }
}
