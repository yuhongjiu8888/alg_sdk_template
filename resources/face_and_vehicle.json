{
  "solution": {
    "type": "chain",
    "stages": [
      { "name": "face_det",    "model": "face_cfg",
        "input": "image", "produces": "objects" },

      { "name": "vehicle_det", "model": "vehicle_cfg",
        "input": "image", "produces": "objects" }
    ]
  },
  "models": {
    "face_cfg": {
      "model_path": "/data/face_det.xmm",
      "preprocess":  { "input_size": [320, 320], "color": "BGR",
                       "resize": "letterbox_tl", "layout": "NCHW" },
      "postprocess": { "type": "fcos_face",
                       "conf_threshold": 0.6, "nms_threshold": 0.4,
                       "strides": [4,8,16,32] }
    },
    "vehicle_cfg": {
      "model_path": "/data/vehicle_det.xmm",
      "preprocess":  { "input_size": [640, 640], "color": "RGB",
                       "resize": "letterbox_center", "layout": "NCHW",
                       "mean": [0,0,0], "std": [255,255,255] },
      "postprocess": { "type": "yolov5_det",
                       "conf_threshold": 0.4, "nms_threshold": 0.5,
                       "num_classes": 4,
                       "labels": ["car","truck","bus","motorcycle"] }
    }
  }
}
